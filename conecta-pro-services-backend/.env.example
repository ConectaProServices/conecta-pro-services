# Prefixo de redes e volumes do Docker Compose (mantém o volume existente do PostgreSQL)
COMPOSE_PROJECT_NAME=conecta-pro-services-backend

# Porta HTTP publicada pela API no host (padrão 3000)
PORT=

DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# Banco exclusivo de testes de integração (pnpm test:integration).
# Use banco e usuário diferentes do desenvolvimento; o nome do banco deve terminar com "_test".
TEST_DB_HOST=
TEST_DB_PORT=
TEST_DB_USERNAME=
TEST_DB_PASSWORD=
TEST_DB_NAME=
TEST_DB_ALLOW_DESTRUCTIVE=false
